"""
MediVoice AI - Environment Variables Example

This file should be copied to .env and populated with actual values.
Never commit real secrets to version control.
"""

# Application
APP_NAME=MediVoice AI
APP_VERSION=1.0.0
DEBUG=False

# Security
SECRET_KEY=change-this-to-a-secure-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
POSTGRES_DB=medivoice_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database URL (auto-generated from above)
# SQLALCHEMY_DATABASE_URL=postgresql+psycopg2://postgres:postgres_password@localhost:5432/medivoice_db

# ChromaDB
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_NAME=medical_knowledge

# LLM APIs
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-google-gemini-api-key-here
DEFAULT_LLM_PROVIDER=openai
DEFAULT_MODEL_NAME=gpt-4o-mini

# Voice AI
WHISPER_MODEL_SIZE=base
EDGE_TTS_VOICE=en-US-JennyNeural
SUPPORTED_LANGUAGES=en,te

# MCP Server
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8001

# File Upload
MAX_UPLOAD_SIZE=10
ALLOWED_EXTENSIONS=pdf,txt,doc,docx

# API
API_V1_PREFIX=/api/v1
